{
  "name": "dsh-widget",
  "version": "0.1.0",
  "description": "Inline visualization widgets for DeepSeek Harness: render model-authored SVG/HTML fragments as isolated visual cards inside the conversation.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/index.test.mjs test/client.test.mjs && node scripts/check-package.mjs",
    "test:unit": "node --test test/index.test.mjs test/client.test.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "dsh": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0",
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "visualization",
    "widget",
    "diagram",
    "chart",
    "svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anneqaq/dsh-widget.git"
  },
  "homepage": "https://github.com/anneqaq/dsh-widget#readme",
  "bugs": {
    "url": "https://github.com/anneqaq/dsh-widget/issues"
  }
}
